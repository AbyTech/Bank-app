MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/banking_system
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
PORT=8000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Smartsupp integration
# REST API v2 access token from https://app.smartsupp.com (Settings -> API)
SMARTSUPP_API_TOKEN=your_smartsupp_api_token_here
SMARTSUPP_BOT_ID=primewave-bot
SMARTSUPP_BOT_NAME=PrimeWave Assistant
# Shared secret used to verify Smartsupp webhook signatures (X-Smartsupp-Hmac).
# Leave empty until webhooks are enabled by Smartsupp support.
SMARTSUPP_WEBHOOK_SECRET=

