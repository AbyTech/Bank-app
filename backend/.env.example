MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Cloudinary (profile picture storage) - credentials stay server-side only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Funding wallet addresses (served to authenticated users via /api/config/funding)
# If left empty, the official addresses in backend/data/fundingMethods.js are used.
BTC_WALLET_ADDRESS=
USDT_WALLET_ADDRESS=
ETH_WALLET_ADDRESS=

# Smartsupp integration
# REST API v2 access token from https://app.smartsupp.com (Settings -> API)
SMARTSUPP_API_TOKEN=your_smartsupp_api_token_here
SMARTSUPP_BOT_ID=primewave-bot
SMARTSUPP_BOT_NAME=PrimeWave Assistant
# Shared secret used to verify Smartsupp webhook signatures (X-Smartsupp-Hmac).
# Leave empty until webhooks are enabled by Smartsupp support.
SMARTSUPP_WEBHOOK_SECRET=

